# Copy to .env and adjust if needed. These defaults match what
# docker-compose.yml and src/web/config.py both fall back to, so `docker
# compose up` works out of the box without a .env file at all — this file
# exists mainly as documentation of what's configurable.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=fnas_lcd
POSTGRES_PASSWORD=fnas_lcd
POSTGRES_DB=fnas_lcd

# ── Object storage (MinIO locally; swap for real S3/ICICLE storage later
#    by changing S3_ENDPOINT_URL and credentials — no code changes needed) ──
S3_ACCESS_KEY=fnas_lcd
S3_SECRET_KEY=fnas_lcd_secret
S3_BUCKET=fnas-lcd-models

# ── Tapis (remote GPU training on SDSC Expanse) ────────────────────────────
# Leave TAPIS_ENABLED=0 for local development: nothing then runs on Expanse,
# and jobs export an untrained model. With 1, training jobs and dataset
# uploads run on Expanse through the apps in tapis/, each with the logged-in
# user's own Tapis login (the X-Tapis-Token cookie an ICICLE pod passes in).
# The service holds no Tapis credentials of its own.
TAPIS_ENABLED=0
# Set to 1 when hosted behind a login portal that hands the app the user's
# Tapis token as an X-Tapis-Token cookie (e.g. an ICICLE pod): every page and
# API route except /health, /static and the upload links then requires a
# valid token. Leave 0 locally, where there is no portal to supply one.
REQUIRE_TAPIS_TOKEN=0
TAPIS_BASE_URL=https://icicleai.tapis.io
TAPIS_APP_ID=fnas-lcd-expanse-train
TAPIS_APP_VERSION=0.1.0
TAPIS_UPLOAD_APP_ID=fnas-lcd-expanse-upload
TAPIS_UPLOAD_APP_VERSION=0.1.0
# The dataset folder of an upload of the bundled toy dataset on Expanse, e.g.
# /expanse/lustre/scratch/harvest/temp_project/jobs/fnas-lcd/uploads/<upload job id>/dataset
# Leave empty if there is none: the toy dataset then isn't offered for training.
TOY_DATASET_REMOTE_PATH=
TAPIS_POLL_SECONDS=30
# At most 800, the limit of Expanse's Tapis queues.
TAPIS_MAX_MINUTES=800
# This service's public address; Tapis downloads uploads from links under it.
PUBLIC_URL=https://fnaslcd.pods.icicleai.tapis.io
