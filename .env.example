# Copy to .env and adjust if needed. These defaults match what
# docker-compose.yml and src/web/config.py both fall back to, so `docker
# compose up` works out of the box without a .env file at all — this file
# exists mainly as documentation of what's configurable.

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=fnas_lcd
POSTGRES_PASSWORD=fnas_lcd
POSTGRES_DB=fnas_lcd

# ── Object storage (MinIO locally; swap for real S3/ICICLE storage later
#    by changing S3_ENDPOINT_URL and credentials — no code changes needed) ──
S3_ACCESS_KEY=fnas_lcd
S3_SECRET_KEY=fnas_lcd_secret
S3_BUCKET=fnas-lcd-models

# ── Tapis (remote GPU training) ───────────────────────────────────────────
# Leave TAPIS_ENABLED=0 for local development: the service then behaves as it
# always has and needs no credentials. Set to 1 to submit real training jobs
# to OSC. Datasets must already exist on the execution system (see
# remote_path in config.py) — this container's paths mean nothing there.
TAPIS_ENABLED=0
TAPIS_BASE_URL=https://icicleai.tapis.io
TAPIS_USERNAME=
TAPIS_PASSWORD=
# TAPIS_JWT=            # alternative to username/password
# Preferred: OAuth client + refresh token, so no user password is stored.
# Register a client (POST /v3/oauth2/clients), then bootstrap the refresh token
# once; it is rotated on use and persisted to the database thereafter.
TAPIS_CLIENT_ID=
TAPIS_CLIENT_KEY=
TAPIS_REFRESH_TOKEN=
TAPIS_APP_ID=fnas-lcd-train
TAPIS_APP_VERSION=0.1.3
TAPIS_SYSTEM=pitzer-tapis
TAPIS_QUEUE=gpu-exp
# in_place (default) bind-mounts the dataset from the exec system; copy has
# Tapis transfer it, which fails above 10,000 files.
TAPIS_STAGE_MODE=in_place
# Path to the bundled toy dataset on the execution system, if you have staged
# it there. Leave empty if not — it simply cannot be trained remotely.
TOY_DATASET_REMOTE_PATH=
# Required when TAPIS_ENABLED=1. A directory writable by the execution
# system's effective user, e.g. /fs/ess/<project>/<user>
TAPIS_WORK_BASE=
TAPIS_POLL_SECONDS=30
TAPIS_MAX_MINUTES=1440
